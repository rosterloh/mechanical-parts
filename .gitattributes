# CAD files: no text diffs (STEP is text but its diffs are noise), and keep generated outputs out of language stats
*.stl  binary
*.stp  -diff linguist-generated
*.step -diff linguist-generated
*/out/** linguist-generated
# supplier CAD too big for plain git
vendor/waveshare-esp32-p4-wifi6-poe-eth/*.stp filter=lfs diff=lfs merge=lfs -text
vendor/waveshare-esp32-p4-eth/*.stp filter=lfs diff=lfs merge=lfs -text
